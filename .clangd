CompileFlags:
  Add:
    - --target=arm-none-eabi
    - -isystem/usr/arm-none-eabi/include/c++/16.1.0
    - -isystem/usr/arm-none-eabi/include/c++/16.1.0/arm-none-eabi
    - -isystem/usr/arm-none-eabi/include/c++/16.1.0/backward
    - -isystem/usr/lib/gcc/arm-none-eabi/16.1.0/include
    - -isystem/usr/lib/gcc/arm-none-eabi/16.1.0/include-fixed
    - -isystem/usr/arm-none-eabi/include
  Remove:
    - -mabi=aapcs
    - -mthumb
    - -fconserve-stack
    - -fno-scheduled-insns

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - "pp_file_not_found"
    - "unused-includes"