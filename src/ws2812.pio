;
; WS2812 LED driver.
;
; A WS2812 bit is a pulse with a fixed total length of (T1 + T2 + T3)
; state-machine cycles:
;   '0' bit: pin high for T1 cycles,      then low for (T2 + T3)
;   '1' bit: pin high for (T1 + T2),      then low for T3
;
; With T1=2, T2=5, T3=3 one bit takes 10 cycles, so clocking the state
; machine at 10 * 800 kHz = 8 MHz yields the required 1.25 us bit period
; (~0.4 us / ~0.8 us high pulses).
;
; Feed format: 24 bits per pixel, GRB order, MSB first, left-justified in
; each 32-bit FIFO word (shift OSR left, autopull threshold 24).
; When the FIFO runs dry the SM stalls in `out` and side-set keeps the
; pin low - that idle-low period is what latches the data into the LEDs.

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1] ; shift next data bit into X, pin low
    jmp !x do_zero  side 1 [T1 - 1] ; pin high; branch on the bit value
do_one:
    jmp bitloop     side 1 [T2 - 1] ; '1': keep driving high -> long pulse
do_zero:
    nop             side 0 [T2 - 1] ; '0': go low early -> short pulse
.wrap
